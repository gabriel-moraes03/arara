# Copie para .env na raiz (nunca versionado). As credenciais só existem no backend.
EARTHDATA_USERNAME=
EARTHDATA_PASSWORD=

# Caminhos relativos à pasta backend/ (padrões abaixo)
# ARARA_DATA_DIR=../data
# ARARA_PYTHON=../.venv/bin/python

# Furnas: pasta com os 9 .h5 locais (regressão) e polígono da ANA (.gdb ou GeoJSON costurado)
FURNAS_H5_DIR=
FURNAS_POLIGONO=

# Limites (padrões)
ARARA_AOI_MAX_KM2=2500
ARARA_MAX_SCENES=12
ARARA_DISK_LIMIT_MB=4096
ARARA_RETENTION_DAYS=7

# Banco PostgreSQL do docker-compose.yml (docker compose up -d). Escolha uma senha; ela só existe aqui.
ARARA_DB_USER=arara
ARARA_DB_PASSWORD=
# ARARA_DB_PORT=5432
# ARARA_DB_URL=jdbc:postgresql://localhost:5432/arara

# Monitor das regiões e desempenho (padrões)
# ARARA_MONITOR=true
# ARARA_MONITOR_INTERVAL_MIN=360
# ARARA_CACHE_MAX_MB=8192
# ARARA_READ_WORKERS=3

# Modo evento (só exibição; é o que a VPS usa, ver deploy/DEPLOY.md e deploy/.env.example).
# SPRING_PROFILES_ACTIVE=event   liga o perfil backend/src/main/resources/application-event.yml:
#   ARARA_MONITOR=false          monitor desligado: nada é processado e não são precisas credenciais Earthdata
#   ARARA_RETENTION_DAYS=36500   a limpeza agendada (padrão: 7 dias) não apaga as análises
#   erros da API sem stack trace nem mensagem interna
