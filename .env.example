# Copie para .env (nunca versionado). As credenciais só existem no backend.
EARTHDATA_USERNAME=
EARTHDATA_PASSWORD=

# Pastas de dados da aplicação
ARARA_DATA_DIR=./data
# Python da pipeline (o venv da raiz)
ARARA_PYTHON=./.venv/bin/python

# Furnas: pasta com os 9 .h5 locais (base da regressão) e polígono da ANA (.gdb ou GeoJSON costurado)
FURNAS_H5_DIR=
FURNAS_POLIGONO=

# Limites (padrões)
ARARA_MAX_AOI_KM2=2500
ARARA_MAX_SCENES=12
ARARA_HEAVY_JOBS=1
ARARA_MAX_DISK_GB=20
ARARA_RETENTION_DAYS=7
