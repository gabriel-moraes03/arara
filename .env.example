# Copie para .env na raiz (nunca versionado). As credenciais só existem no backend.
EARTHDATA_USERNAME=
EARTHDATA_PASSWORD=

# Caminhos relativos à pasta backend/ (padrões abaixo)
# ARARA_DATA_DIR=../data
# ARARA_PYTHON=../.venv/bin/python

# Furnas: pasta com os 9 .h5 locais (regressão) e polígono da ANA (.gdb ou GeoJSON costurado)
FURNAS_H5_DIR=
FURNAS_POLIGONO=

# Limites (padrões)
ARARA_AOI_MAX_KM2=2500
ARARA_MAX_SCENES=12
ARARA_DISK_LIMIT_MB=4096
ARARA_RETENTION_DAYS=7
