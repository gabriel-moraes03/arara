# Copie para deploy/.env na VPS (nunca versionado). Lido pelo docker-compose.prod.yml e pelo restore.sh.

# Banco PostgreSQL (só na rede interna do compose). Escolha uma senha forte; ela só existe aqui.
ARARA_DB_USER=arara
ARARA_DB_PASSWORD=

# Domínio público. Vazio = HTTP na porta 80, acesso pelo IP. Com um domínio apontando para a VPS
# (registro A), o Caddy pede o certificado Let's Encrypt e serve HTTPS na 443.
DOMAIN=

# Modo evento (perfil "event"): os padrões abaixo já valem; só mude se souber o que está fazendo.
# Monitor das regiões. false = nada é processado na VPS e não são precisas credenciais Earthdata.
ARARA_MONITOR=false
# Dias até a limpeza agendada apagar uma análise. 36500 = nunca, durante o evento.
ARARA_RETENTION_DAYS=36500

# Portas publicadas pelo Caddy (padrão 80 e 443). Só mude se a máquina já usar essas portas
# (Let's Encrypt precisa da 80 e da 443 de verdade quando há DOMAIN).
# HTTP_PORT=80
# HTTPS_PORT=443
